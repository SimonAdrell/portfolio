{
	"permissions": {
		"allow": [
			"Bash(npm run verify)",
			"Bash(npm run check)",
			"Bash(npm run lint)",
			"Bash(npm run test:unit:*)",
			"Bash(npm run test:e2e:*)",
			"Bash(npx vitest:*)",
			"Bash(npx playwright test:*)",
			"Bash(git status)",
			"Bash(git diff:*)",
			"Bash(git log:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.*)", "Read(./sendgrid.env)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
						"timeout": 120
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-stop.mjs\"",
						"timeout": 600
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.mjs\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
