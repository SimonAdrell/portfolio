# Staged files only. Typecheck and tests stay in npm run verify and CI.
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r npx --no-install prettier --check --ignore-unknown
git diff --cached --name-only --diff-filter=ACMR -z -- '*.ts' '*.js' '*.mjs' '*.cjs' '*.svelte' | xargs -0 -r npx --no-install eslint --cache --max-warnings 0 --no-warn-ignored
